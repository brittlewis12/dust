## Infra (Elasticsearch, Kibana, Qdrant)
ES_LOCAL_VERSION=8.17.4
ES_LOCAL_HEAP_INIT=2g
ES_LOCAL_HEAP_MAX=4g
ES_LOCAL_PORT=9200
ES_LOCAL_CONTAINER_NAME=dust-elasticsearch
KIBANA_LOCAL_CONTAINER_NAME=dust-kibana
KIBANA_LOCAL_PORT=5601
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic
KIBANA_LOCAL_PASSWORD=kibana
KIBANA_ENCRYPTION_KEY=please-change-me-to-a-random-32-plus-char-string
RUN_MODE=dev
QDRANT_CLUSTER_0_URL=http://localhost:6334
QDRANT_CLUSTER_0_API_KEY=qdrant
QDRANT__SERVICE__API_KEY=qdrant

## Runtime
NODE_ENV=development
DUST_REGION=local
REDIS_URI=redis://localhost:6379
REDIS_CACHE_URI=redis://localhost:6379

## Databases (Postgres URIs)
FRONT_DATABASE_URI=postgres://dev:dev@localhost:5432/dust_front
CONNECTORS_DATABASE_URI=postgres://dev:dev@localhost:5432/dust_connectors
CORE_DATABASE_URI=postgres://dev:dev@localhost:5432/dust_api
CORE_DATABASE_READ_REPLICA_URI=postgres://dev:dev@localhost:5432/dust_api
DATABASES_STORE_DATABASE_URI=postgres://dev:dev@localhost:5432/dust_databases_store
OAUTH_DATABASE_URI=postgres://dev:dev@localhost:5432/dust_oauth

## Core / APIs
CORE_API=http://localhost:3001
CORE_API_KEY=dev-core-api-key
DUST_FRONT_API=http://localhost:3000
OAUTH_API=http://localhost:3006
OAUTH_API_KEY=dev-oauth-api-key
OAUTH_ENCRYPTION_KEY=replace-with-URL-safe-base64-key

## Providers (set the ones you need)
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# ANTHROPIC_API_KEY=

## WorkOS (Auth)
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=replace-with-workos-client-id
WORKOS_COOKIE_PASSWORD=replace-with-random-32-plus-char-secret
WORKOS_ISSUER_URL=https://api.workos.com

## Front (Next)
NEXT_PUBLIC_DUST_CLIENT_FACING_URL=http://localhost:3000
NEXT_PUBLIC_COMMIT_HASH=development

## Dust Apps (seed script will print these)
DUST_APPS_WORKSPACE_ID=
DUST_APPS_SPACE_ID=

## Temporal (optional for local)
# TEMPORAL_NAMESPACE=default
# TEMPORAL_AGENT_NAMESPACE=default
# TEMPORAL_CONNECTORS_NAMESPACE=default
